<?xml version="1.0" encoding="utf-8"?>
<!-- The Building widget (ADR 0011): the user's tower, one floor per Finish,
     with tonight's Window on top. Drawn from the same push as the Road
     widget; the half-hourly update only lets the Window go dark at 4 a.m. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_building_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/home_widget_building_preview"
    android:minWidth="110dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"/>
