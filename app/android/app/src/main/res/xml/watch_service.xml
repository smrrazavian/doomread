<?xml version="1.0" encoding="utf-8"?>
<!-- WatchService (ADR 0014, 0015): which app's window comes to the front,
     and, in the Work app only, whether given view ids are on screen (Shorts
     in YouTube). Not an accessibility tool, and it reads no text. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:description="@string/watch_description"/>
