<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Signing in and sync talk to the Doomread server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The ongoing notification while a Session runs, asked for in context
         (Android 13+), and its promotion to a Live Update (Android 16+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <!-- The "break's over" notification at the end of a Planned break: exact
         when the user allows it (off by default on Android 14+), otherwise
         inexact. Its receiver, BreakOverReceiver, is in <application>. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- The fallback when Accessibility is off (ADR 0016): usage access,
         granted by the user in Settings, polled by a foreground service, and
         display over other apps, so the "not yet" screen can come up. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application
        android:label="@string/app_name"
        android:appCategory="productivity"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Posts the "break's over" notification when its alarm goes off. -->
        <receiver android:name=".BreakOverReceiver" android:exported="false"/>
        <!-- The home screen widget (ADR 0011): drawn by Glance from what the
             app last pushed. -->
        <receiver
            android:name=".HomeWidget$Receiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget"/>
        </receiver>
        <!-- The Building widget: the same push, drawn as the user's tower. -->
        <receiver
            android:name=".HomeWidget$BuildingReceiver"
            android:exported="true"
            android:label="@string/widget_building_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_building"/>
        </receiver>
        <!-- Reports which app comes to the front, for the "not yet" screen
             (ADR 0014). Only the system can bind it. -->
        <service
            android:name=".WatchService"
            android:exported="true"
            android:label="@string/watch_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/watch_service"/>
        </service>
        <!-- Polls usage access while a Session is open and Accessibility is
             off (ADR 0016). -->
        <service
            android:name=".UsageWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Notices which app comes to the front during a reading Session, through usage access, when the user has no Accessibility service on, to show a reminder screen."/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- The launchable apps, to pick Watched apps from and to open one
             after a Slip; not QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
