#!/usr/bin/env bash
# Run any command inside the Doomread dev container, e.g.
#   tool/dev flutter test
#   tool/dev adb pair 192.168.1.20:37099 123456
set -euo pipefail
cd "$(dirname "$0")/.."

# The tag follows the Dockerfile, so editing it rebuilds the image.
# CI publishes each tag to GHCR, so a missing image is pulled before falling back to a build.
tag=$(sha256sum tool/Dockerfile | cut -c1-12)
image=${DOOMREAD_IMAGE:-doomread-dev:$tag}
remote=ghcr.io/smrrazavian/doomread-dev:$tag
if ! docker image inspect "$image" >/dev/null 2>&1; then
  if docker pull "$remote"; then
    docker tag "$remote" "$image"
  else
    tool/fetch-sdk.sh && docker build -t "$image" -f tool/Dockerfile tool || exit 1
  fi
fi

tty=(); [ -t 0 ] && tty=(-it)

# Pass the host's proxy through (pub.dev and Google Maven are blocked from Iran without one).
# Gradle runs on the JVM, which ignores *_PROXY; see gradle-init.d/proxy.gradle.
env=()
for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy MAVEN_MIRROR; do
  [ -n "${!v:-}" ] && env+=(-e "$v=${!v}")
done
proxy=${HTTPS_PROXY:-${https_proxy:-}}
if [[ $proxy =~ ^https?://([^@/]*@)?([^:/]+):([0-9]+) ]]; then
  h=${BASH_REMATCH[2]} p=${BASH_REMATCH[3]}
  # For the Gradle client JVM (it downloads the wrapper); builds get theirs from gradle-init.d/proxy.gradle.
  env+=(-e "JAVA_TOOL_OPTIONS=-Dhttp.proxyHost=$h -Dhttp.proxyPort=$p -Dhttps.proxyHost=$h -Dhttps.proxyPort=$p")
fi

# USB phones: a bind mount keeps the host's per-user ACL on the device node
# (set by the udev rule in the README); 189 is the USB device major number.
usb=(); [ -d /dev/bus/usb ] && usb=(-v /dev/bus/usb:/dev/bus/usb --device-cgroup-rule 'c 189:* rmw')

# One long-lived container (named after the checkout) is reused across calls, so
# Gradle's daemon, adb's server and Dart's caches stay warm. It is recreated
# when the image or this script changes; `docker ps -a --filter name=doomread-dev` lists them; `docker rm -f` resets one.
# --network host lets adb reach the phone over wireless debugging.
# The doomread-home volume keeps pub/Gradle caches and adb pairing keys, shared by every checkout
# (Gradle and pub lock their caches for concurrent use).
# One container per checkout (worktrees get their own, mounting their own files). Each keeps its
# Gradle and Kotlin daemons to itself: their registries would otherwise sit in the shared volume,
# and over the shared host network one checkout's build would run in another's daemon, on its /work.
name=doomread-dev-$(printf %s "$PWD" | sha256sum | cut -c1-8)
config="$image $(sha256sum tool/dev | cut -c1-12)"
if [ "$(docker inspect -f '{{index .Config.Labels "doomread.config"}}' "$name" 2>/dev/null)" != "$config" ]; then
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run -d --name "$name" --label "doomread.config=$config" --network host "${usb[@]}" \
    -v "$PWD":/work -w /work \
    -v doomread-home:/home/dev \
    --tmpfs /home/dev/.gradle/daemon:mode=1777,size=1g \
    --tmpfs /home/dev/.kotlin:mode=1777,size=256m \
    -v "$PWD/tool/gradle-init.d":/home/dev/.gradle/init.d:ro \
    "$image" sleep infinity >/dev/null
elif [ "$(docker inspect -f '{{.State.Running}}' "$name")" != true ]; then
  docker start "$name" >/dev/null
fi
exec docker exec "${tty[@]}" "${env[@]}" -w /work "$name" "$@"
